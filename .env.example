# Konfigurasi Personal All-in-One Media Downloader

# Path ke executable yt-dlp (opsional jika sudah ada di PATH sistem Windows / Linux)
# Contoh Windows: C:\yt-dlp\yt-dlp.exe
# Contoh Linux/WSL: /home/user/.local/bin/yt-dlp
YTDLP_PATH=

# Path ke executable ffmpeg (opsional jika sudah ada di PATH sistem Windows / Linux)
# Contoh Windows: C:\ffmpeg\bin\ffmpeg.exe
# Contoh Linux/WSL: /usr/bin/ffmpeg
FFMPEG_PATH=

# Direktori penyimpanan hasil unduhan (relatif terhadap root proyek atau path absolut)
DOWNLOAD_DIR=./downloads

# Batas unduhan paralel secara bersamaan (default 1 untuk stabilitas sumber daya)
MAX_CONCURRENT_DOWNLOADS=1

# Batas durasi maksimal media dalam menit (0 untuk tanpa batas)
MAX_DURATION_MINUTES=180

# Pembersihan otomatis file unduhan (dalam menit, default 60 menit. 0 = nonaktif)
AUTO_CLEANUP_MINUTES=60

# Port dan Host lokal
PORT=48888
HOST=0.0.0.0
